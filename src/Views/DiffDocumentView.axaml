<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:app="using:Sextant"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Sextant.Views.DiffDocumentView"
             x:DataType="vm:RepositoryViewModel">
    <DockPanel>
                    <CommandBar x:Name="DiffCommandBar" DockPanel.Dock="Top" Margin="0,4,0,0"
                                IsVisible="{Binding ShowDiffCommandBar}"
                                DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed" IsDynamicOverflowEnabled="False">
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <CommandBarButton Label="Stage all" LabelPosition="Right" Command="{Binding StageAllCommand}" IsEnabled="{Binding CanStageAll}" IsVisible="{Binding ShowBulkActions}">
                                    <CommandBarButton.Icon>
                                        <PathIcon Width="14" Height="14" Data="M6,1 L8,1 L8,6 L13,6 L13,8 L8,8 L8,13 L6,13 L6,8 L1,8 L1,6 L6,6 Z"/>
                                    </CommandBarButton.Icon>
                                </CommandBarButton>
                                <CommandBarButton Label="Unstage all" LabelPosition="Right" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding CanUnstageAll}" IsVisible="{Binding ShowBulkActions}">
                                    <CommandBarButton.Icon>
                                        <PathIcon Width="14" Height="14" Data="M1,6 L13,6 L13,8 L1,8 Z"/>
                                    </CommandBarButton.Icon>
                                </CommandBarButton>
                                <CommandBarButton Label="Discard all" LabelPosition="Right" Command="{Binding DiscardAllCommand}" IsEnabled="{Binding CanDiscardAll}" IsVisible="{Binding ShowBulkActions}">
                                    <CommandBarButton.Icon>
                                        <PathIcon Width="14" Height="14" Data="M2,2 L4,2 L7,5 L10,2 L12,2 L8,6 L12,10 L10,10 L7,7 L4,10 L2,10 L6,6 Z"/>
                                    </CommandBarButton.Icon>
                                </CommandBarButton>
                            </StackPanel>
                        </CommandBar.Content>
                        <CommandBarButton Label="Expand all" Command="{Binding ExpandAllSectionsCommand}" IsVisible="{Binding ShowSectionFolds}" HotKey="{app:CommandGesture Key=E, Shift=True}">
                            <CommandBarButton.Icon>
                                <PathIcon Width="14" Height="14" Data="M2,3 L8,9 L14,3 L12,3 L8,7 L4,3 Z M2,8 L8,14 L14,8 L12,8 L8,12 L4,8 Z"/>
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton Label="Collapse all" Command="{Binding CollapseAllSectionsCommand}" IsVisible="{Binding ShowSectionFolds}" HotKey="{app:CommandGesture Key=OemMinus, Shift=True}">
                            <CommandBarButton.Icon>
                                <PathIcon Width="14" Height="14" Data="M2,7 L8,1 L14,7 L12,7 L8,3 L4,7 Z M2,13 L8,7 L14,13 L12,13 L8,9 L4,13 Z"/>
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                    </CommandBar>
                    <WrapPanel DockPanel.Dock="Top" Margin="8,4,8,0" IsVisible="{Binding ShowingMerge}">
                        <Button Classes="flat" Content="Previous" Command="{Binding PreviousConflictCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Next" Command="{Binding NextConflictCommand}" Margin="0,0,4,4"/>
                        <TextBlock Text="{Binding MergeConflictLabel}" VerticalAlignment="Center" Opacity="0.75" Margin="4,0,8,4"/>
                        <Button Classes="flat" Content="Take ours" Command="{Binding TakeOursCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Take theirs" Command="{Binding TakeTheirsCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="{Binding MergeBaseLabel}" Command="{Binding ToggleMergeBaseCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Save and stage" Command="{Binding SaveConflictCommand}" Margin="0,0,4,4"/>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,4">
                        <TextBlock Text="{Binding DiffNotice}" IsVisible="{Binding HasDiffNotice}" TextWrapping="Wrap"
                                   MaxLines="8" TextTrimming="CharacterEllipsis" Opacity="0.75"/>
                        <Button Classes="flat" Content="Load anyway" Command="{Binding LoadLargeDiffCommand}" IsVisible="{Binding ShowLoadDiff}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <ScrollViewer IsVisible="{Binding HasLfsNotice}" MaxHeight="168" Margin="0,4,0,0"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LfsNotice}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <Button Classes="flat" Content="Show the file" Command="{Binding ShowLfsCommand}" IsVisible="{Binding ShowLfsDownload}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid RowDefinitions="*,Auto">
                        <views:CopyListBox x:Name="DiffList" ItemsSource="{Binding DiffRows}" Background="Transparent" IsVisible="{Binding ShowingRows}"
                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <views:CopyListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </views:CopyListBox.Styles>
                            <views:CopyListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:DiffVirtualizingPanel/>
                                </ItemsPanelTemplate>
                            </views:CopyListBox.ItemsPanel>
                            <views:CopyListBox.DataTemplates>
                                <DataTemplate DataType="vm:DiffHunkRow" x:DataType="vm:DiffHunkRow">
                                    <Border Margin="8,10,8,4" Padding="8,6" CornerRadius="6" BorderThickness="1"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                                <Button Classes="accent" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Content="Discard hunk" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}"/>
                                                <Button Classes="accent" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}"/>
                                            </StackPanel>
                                            <views:CopyableText Classes="diff" CopyKey="span" Text="{Binding Header}" Opacity="0.85"
                                                                VerticalAlignment="Center" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffEditorRow" x:DataType="vm:DiffEditorRow">
                                    <views:DiffTextHost Editor="{Binding}" Shift="{Binding $parent[views:DiffDocumentView].SideShift}"/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffLineRow" x:DataType="vm:DiffLineRow">
                                    <DockPanel>
                                        <Button Classes="flat" DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}" Padding="6,0"/>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Classes="diff" Text="{Binding OldNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="0,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            <TextBlock Classes="diff" Text="{Binding NewNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="0,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <views:HighlightedText Classes="diff" CopyKey="body" Source="{Binding Text}" Language="{Binding Language}" Background="{Binding Background}" Padding="8,0"/>
                                    </DockPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffSideRow" x:DataType="vm:DiffSideRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,*">
                                        <TextBlock Classes="diff" Text="{Binding LeftNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="8,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{Binding LeftBackground}">
                                            <views:ClipShift Shift="{Binding $parent[views:DiffDocumentView].SideShift}">
                                                <views:HighlightedText Classes="diff" CopyKey="left" Source="{Binding Left}" Language="{Binding Language}" Padding="8,0" HorizontalAlignment="Left"/>
                                            </views:ClipShift>
                                        </Border>
                                        <Border Grid.Column="2" Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                                        <TextBlock Grid.Column="3" Classes="diff" Text="{Binding RightNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="8,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        <Border Grid.Column="4" Background="{Binding RightBackground}">
                                            <views:ClipShift Shift="{Binding $parent[views:DiffDocumentView].SideShift}">
                                                <views:HighlightedText Classes="diff" CopyKey="right" Source="{Binding Right}" Language="{Binding Language}" Padding="8,0" HorizontalAlignment="Left"/>
                                            </views:ClipShift>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffImageRow" x:DataType="vm:DiffImageRow">
                                    <Grid Margin="8,0,8,12" ColumnDefinitions="*,12,*">
                                        <Border Padding="8" MinHeight="280" Background="#1A000000" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Image.BeforeCaption}" Opacity="0.72" Margin="0,0,0,8"/>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Image.BeforeDetail}" IsVisible="{Binding Image.HasBeforeDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding Image.BeforeNotice}" IsVisible="{Binding Image.ShowBeforeNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75"/>
                                                <controls:FbxOrbitView Source="{Binding Image.Before}" Orbit="{Binding Image.BeforeOrbit}" IsHitTestVisible="{Binding Image.HasBeforeOrbit}"
                                                                       MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Image.HasBefore}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="8" MinHeight="280" Background="#1A000000" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Image.AfterCaption}" Opacity="0.72" Margin="0,0,0,8"/>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Image.AfterDetail}" IsVisible="{Binding Image.HasAfterDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding Image.AfterNotice}" IsVisible="{Binding Image.ShowAfterNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75"/>
                                                <controls:FbxOrbitView Source="{Binding Image.After}" Orbit="{Binding Image.AfterOrbit}" IsHitTestVisible="{Binding Image.HasAfterOrbit}"
                                                                       MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Image.HasAfter}"/>
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Grid.ColumnSpan="3" IsVisible="{Binding Image.IsLoading}" IsHitTestVisible="False"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <controls:LoadingSpinner Width="22" Height="22" HorizontalAlignment="Center"
                                                                     IsVisible="{Binding Image.IsLoading}"
                                                                     AutomationProperties.Name="Loading image"/>
                                            <TextBlock Text="Loading…" HorizontalAlignment="Center" Opacity="0.72"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffFileRow" x:DataType="vm:DiffFileRow">
                                    <Border Margin="8,10,8,4" Padding="8,6" CornerRadius="6" BorderThickness="1"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            PointerPressed="OnDiffHeaderPressed">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="OnMenuOpening">
                                                <MenuItem Header="Copy filename" Command="{Binding FileMenu.CopyFileNameCommand}"/>
                                                <MenuItem Header="Copy path" Command="{Binding FileMenu.CopyPathCommand}"/>
                                                <MenuItem Header="Copy full path" Command="{Binding FileMenu.CopyFullPathCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="{Binding FileMenu.OpenFolderLabel}" Command="{Binding FileMenu.OpenFolderCommand}"/>
                                                <MenuItem Header="Open in editor" Command="{Binding FileMenu.OpenEditorCommand}"/>
                                                <Separator IsVisible="{Binding FileMenu.ShowLfsMenu}"/>
                                                <MenuItem Header="Track with LFS" Command="{Binding FileMenu.LfsTrackCommand}" IsVisible="{Binding FileMenu.ShowLfsTrack}"/>
                                                <MenuItem Header="Stop tracking with LFS" Command="{Binding FileMenu.LfsUntrackCommand}" IsVisible="{Binding FileMenu.ShowLfsUntrack}"/>
                                                <MenuItem Header="Download" Command="{Binding FileMenu.LfsDownloadCommand}" IsVisible="{Binding FileMenu.ShowLfsDownload}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="16,*,Auto,Auto,Auto">
                                            <Button Classes="flat" Width="16" Height="16" Padding="0" MinWidth="0"
                                                    Command="{Binding ToggleCommand}" IsVisible="{Binding CanFold}"
                                                    Background="Transparent" VerticalAlignment="Center"
                                                    ToolTip.Tip="Show or hide this file">
                                                <Path Data="M2,1 L7,6 L2,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                                                      RenderTransformOrigin="50%,50%">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="{Binding ExpandAngle}"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Tip}"/>
                                            <Border Grid.Column="2" IsVisible="{Binding LfsTracked}" Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                                                    VerticalAlignment="Center" Background="#3347C4C4" ToolTip.Tip="Tracked with Git LFS">
                                                <TextBlock Text="LFS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding StagingLabel}" IsVisible="{Binding ShowAction}"
                                                       Margin="12,0,0,0" Opacity="0.7" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" Classes="accent" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="vm:BlameRow" x:DataType="vm:BlameRow">
                                    <Grid ColumnDefinitions="48,180,*">
                                        <views:CopyableText Classes="diff" CopyKey="number" Text="{Binding Number}" Opacity="0.55"/>
                                        <views:CopyableText Grid.Column="1" Classes="diff" CopyKey="meta" Text="{Binding Meta}" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <views:HighlightedText Grid.Column="2" Classes="diff" CopyKey="blame" Source="{Binding Text}" Language="{Binding Language}"/>
                                    </Grid>
                                </DataTemplate>
                            </views:CopyListBox.DataTemplates>
                        </views:CopyListBox>
                        <views:MergeEditor Grid.Row="0" IsVisible="{Binding ShowingMerge}"
                                           Session="{Binding MergeEdit}"
                                           FilePath="{Binding MergePath}"
                                           ShowBase="{Binding ShowMergeBase}"
                                           ConflictIndex="{Binding MergeConflictIndex}"/>
                        <ScrollBar x:Name="SideBar" Grid.Row="1" Orientation="Horizontal"
                                   Minimum="0" AllowAutoHide="False" IsVisible="False"/>
                    </Grid>
                </DockPanel>
</UserControl>
