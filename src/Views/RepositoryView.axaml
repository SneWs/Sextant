<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Sextant.Views.RepositoryView"
             x:DataType="vm:RepositoryViewModel"
             KeyDown="OnViewKeyDown">
    <!-- These styles stay on the composer so headless tests that do not load App.axaml still match. The dock uses the copies in App.axaml. -->
    <UserControl.Styles>
        <Style Selector="Button.locationsearch.pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="SplitButton.commit /template/ Button#PART_PrimaryButton">
            <Setter Property="IsEnabled" Value="{Binding CanCommit}"/>
        </Style>
        <Style Selector="SplitButton.compact /template/ Button#PART_PrimaryButton">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="SplitButton.compact /template/ ToggleButton#PART_FlyoutToggle">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
        <Style Selector="Button.viewtab">
            <Setter Property="Theme" Value="{StaticResource FlatButton}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="Button.viewtab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Button.viewtab.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.viewtab.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
        </Style>
        <Style Selector="Button.viewtab.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <views:RepositoryChrome/>
        <Grid x:Name="Columns" Grid.Row="1" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="520" MinWidth="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:LocationsToolView Grid.Column="0" IsVisible="{Binding ShowLocations}"/>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <views:HistoryToolView/>
                <views:RepositoryFilesToolView Grid.Row="1" Height="280" IsVisible="{Binding RepositoryFilesTabOn}"/>
            </Grid>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>

            <Grid x:Name="Details" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180" MinHeight="80"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <views:ChangesToolView Grid.Row="0"/>
                <views:StagingToolView Grid.Row="1"/>
                <GridSplitter Grid.Row="2" ResizeDirection="Rows"/>
                <views:DiffDocumentView Grid.Row="3"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" IsVisible="{Binding CommandsOpen}" HorizontalAlignment="Stretch"
                Height="168" Padding="8,4,8,8" Margin="0" ClipToBounds="True"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <views:CommandLogToolView/>
        </Border>
    </Grid>
</UserControl>
