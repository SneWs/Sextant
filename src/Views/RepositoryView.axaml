<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Sextant.Views.RepositoryView"
             x:DataType="vm:RepositoryViewModel"
             KeyDown="OnViewKeyDown">
    <UserControl.Styles>
        <Style Selector="Button.locationsearch.pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Button.viewtab">
            <Setter Property="Theme" Value="{StaticResource FlatButton}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="Button.viewtab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Button.viewtab.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.viewtab.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
        </Style>
        <Style Selector="Button.viewtab.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <!-- Eight rows. A longer message scrolls inside the bar, and Copy still takes the whole text. -->
        <Border Grid.Row="0" IsVisible="{Binding HasBanner}" Padding="10,6" MaxHeight="168"
                ClipToBounds="True" Background="#33C42B1C">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Classes="flat" Content="Copy" Command="{Binding CopyBannerCommand}"/>
                    <Button Classes="flat" Content="Dismiss" Command="{Binding DismissBannerCommand}"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding IsConflicted}" Padding="10,6" Background="#33E0A100">
            <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" IsVisible="{Binding SparseCheckout}" Padding="10,6" Background="#332B6CB0">
            <TextBlock Text="Sparse checkout is on. Excluded paths stay out of the working tree." TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3" Margin="8,6" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BranchEnds"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BranchEnds"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="210"
                    MaxWidth="840"
                    Padding="16,5"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BranchText}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="275"/>
                    <TextBlock Grid.Column="1" Text="·" Opacity="0.45" VerticalAlignment="Center" Margin="8,0,0,0"
                               IsVisible="{Binding ShowBranchStatus}"/>
                    <TextBlock Grid.Column="2" Text="{Binding AheadBehindText}" IsVisible="{Binding ShowAheadBehind}"
                               VerticalAlignment="Center" Opacity="0.72" FontSize="12" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}"
                               VerticalAlignment="Center" Opacity="0.72" FontSize="12" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Panel.ZIndex="1">
                <SplitButton Content="Pull" Command="{Binding PullCommand}" IsEnabled="{Binding CanRunCommands}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Fetch" Command="{Binding FetchCommand}"/>
                            <MenuItem Header="Fetch all" Command="{Binding FetchAllCommand}"/>
                            <MenuItem Header="Fetch all and clean up" Command="{Binding FetchAllAndCleanUpCommand}"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Content="Push" Command="{Binding PushCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanRunCommands}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Push" Command="{Binding PushCommand}"/>
                            <MenuItem Header="Push ignoring local checks" Command="{Binding PushIgnoringLocalChecksCommand}"/>
                            <MenuItem Header="Push with force-with-lease" Command="{Binding PushForceWithLeaseCommand}"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Content="Continue" Command="{Binding ContinueSequencerCommand}" Margin="6,0,0,0" IsVisible="{Binding IsConflicted}"/>
                <Button Content="Abort" Command="{Binding AbortMergeCommand}" Margin="6,0,0,0" IsVisible="{Binding IsConflicted}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0" IsVisible="{Binding CanCancel}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="8,0,8,4" Spacing="4" IsVisible="{Binding ShowHistoryChrome}">
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowHistorySearch}">
                <TextBox x:Name="HistorySearchBox" PlaceholderText="Search subject, author, sha, branch:name, *.fbx, or MyFile.cs" Text="{Binding HistoryText}" KeyDown="OnHistoryKeyDown"/>
                <Button x:Name="HistorySearchButton" Grid.Column="1" Classes="flat" Width="22" Height="22" Padding="0" MinWidth="0"
                        Margin="4,0,0,0" Command="{Binding SearchHistoryCommand}"
                        ToolTip.Tip="Search" Background="Transparent" VerticalAlignment="Center">
                    <Canvas Width="14" Height="14">
                        <Ellipse Width="8" Height="8" Canvas.Left="1" Canvas.Top="1"
                                 Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"/>
                        <Line StartPoint="7.6,7.6" EndPoint="12.2,12.2"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                              StrokeLineCap="Round"/>
                    </Canvas>
                </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasHistoryFilter}">
                <Button x:Name="HistoryCloseButton" Command="{Binding ShowAllCommitsCommand}"
                        IsVisible="{Binding HasHistoryQuery}" IsEnabled="{Binding CanRunCommands}"
                        Classes="accent" Width="28" Height="28" Padding="0" MinWidth="0" CornerRadius="8"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Close history"
                        ToolTip.Tip="Show the commit graph">
                    <Canvas Width="12" Height="12">
                        <Line StartPoint="1,1" EndPoint="11,11"
                              Stroke="{DynamicResource CatppuccinOnAccentBrush}" StrokeThickness="2" StrokeLineCap="Round"/>
                        <Line StartPoint="11,1" EndPoint="1,11"
                              Stroke="{DynamicResource CatppuccinOnAccentBrush}" StrokeThickness="2" StrokeLineCap="Round"/>
                    </Canvas>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding HistoryCaption}" Opacity="0.75" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <Grid x:Name="Columns" Grid.Row="5" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="520" MinWidth="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" IsVisible="{Binding ShowLocations}" RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="8,2,4,2">
                    <TextBlock Text="Locations" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="LocationSearchButton" Grid.Column="1" Classes="flat locationsearch"
                            Classes.pressed="{Binding LocationFilterOpen}"
                            Width="22" Height="22" Padding="0" MinWidth="0"
                            Command="{Binding ToggleLocationFilterCommand}"
                            ToolTip.Tip="Filter locations"
                            Background="Transparent" VerticalAlignment="Center">
                        <Canvas Width="14" Height="14">
                            <Ellipse Width="8" Height="8" Canvas.Left="1" Canvas.Top="1"
                                     Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"/>
                            <Line StartPoint="7.6,7.6" EndPoint="12.2,12.2"
                                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                  StrokeLineCap="Round"/>
                        </Canvas>
                    </Button>
                </Grid>
                <TextBox x:Name="LocationFilterBox" Grid.Row="1" Margin="4,0,4,4"
                         PlaceholderText="Filter" Text="{Binding LocationFilter}"
                         IsVisible="{Binding LocationFilterOpen}" KeyDown="OnLocationFilterKeyDown"/>
            <ListBox x:Name="LocationList" Grid.Row="2" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Tapped="OnLocationTapped" DoubleTapped="OnLocationDoubleTapped">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocationItem">
                        <Border Background="Transparent" Padding="2,0">
                            <Border.ContextMenu>
                                <ContextMenu Opening="OnMenuOpening">
                                    <MenuItem Header="Create branch from tag" Command="{Binding CreateBranchFromTagCommand}" IsVisible="{Binding ShowTag}"/>
                                    <MenuItem Header="Checkout tag" Command="{Binding CheckoutTagCommand}" IsVisible="{Binding ShowTag}"/>
                                    <MenuItem Header="Push tag" Command="{Binding PushTagCommand}" IsVisible="{Binding ShowTag}"/>
                                    <MenuItem Header="Delete tag" Command="{Binding DeleteCommand}" IsVisible="{Binding ShowTag}"/>
                                    <Separator IsVisible="{Binding ShowTag}"/>
                                    <MenuItem Header="Delete tag from origin" Command="{Binding DeleteRemoteTagCommand}" IsVisible="{Binding ShowTag}"/>
                                    <MenuItem Header="Open" Command="{Binding OpenCommand}" IsVisible="{Binding ShowOpen}"/>
                                    <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}" IsVisible="{Binding ShowCheckout}"/>
                                    <MenuItem Header="{Binding MergeLabel}" Command="{Binding MergeCommand}" IsVisible="{Binding ShowMerge}"/>
                                    <MenuItem Header="{Binding RebaseLabel}" Command="{Binding RebaseCommand}" IsVisible="{Binding ShowRebase}"/>
                                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding ShowDelete}"/>
                                    <MenuItem Header="Set upstream" Command="{Binding SetUpstreamCommand}" IsVisible="{Binding ShowSetUpstream}"/>
                                    <MenuItem Header="Show in graph" Command="{Binding RevealCommand}" IsVisible="{Binding ShowReveal}"/>
                                    <Separator IsVisible="{Binding ShowHide}"/>
                                    <MenuItem Header="{Binding HideLabel}" Command="{Binding HideCommand}" IsVisible="{Binding ShowHide}"/>
                                    <MenuItem Header="Hide all other branches" Command="{Binding HideOthersCommand}" IsVisible="{Binding ShowHideOthers}"/>
                                    <MenuItem Header="Show all branches" Command="{Binding ShowAllBranchesCommand}" IsVisible="{Binding ShowAllBranches}"/>
                                    <MenuItem Header="Rename" Command="{Binding RenameCommand}" IsVisible="{Binding ShowRename}"/>
                                    <MenuItem Header="Pop" Command="{Binding PopCommand}" IsVisible="{Binding ShowPop}"/>
                                    <MenuItem Header="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding ShowApply}"/>
                                    <MenuItem Header="Drop" Command="{Binding DropCommand}" IsVisible="{Binding ShowDrop}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="16,*,Auto" Margin="{Binding Indent}">
                                <Button Grid.Column="0" Classes="flat" Width="16" Height="16" Padding="0" MinWidth="0"
                                        IsVisible="{Binding HasChildren}"
                                        Click="OnLocationExpand" DoubleTapped="OnLocationExpandDoubleTapped"
                                        Background="Transparent" VerticalAlignment="Center">
                                    <Path Data="M2,1 L7,6 L2,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                          StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                                          RenderTransformOrigin="50%,50%">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="{Binding ExpandAngle}"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="{Binding Weight}" Opacity="{Binding LabelOpacity}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="flat eye" Width="18" Height="18" Padding="0" MinWidth="0" Margin="4,0,2,0"
                                        IsVisible="{Binding ShowEye}"
                                        Command="{Binding HideCommand}"
                                        ToolTip.Tip="{Binding HideLabel}"
                                        DoubleTapped="OnLocationExpandDoubleTapped"
                                        Background="Transparent" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M1,8 C4,3.5 12,3.5 15,8 C12,12.5 4,12.5 1,8 Z"
                                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.2"
                                              Fill="Transparent"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6"
                                                 Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                 IsVisible="{Binding EyeOpen}"/>
                                        <Line StartPoint="2.5,12.5" EndPoint="13.5,3.5"
                                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.3"
                                              StrokeLineCap="Round" IsVisible="{Binding EyeHidden}"/>
                                    </Canvas>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" IsVisible="{Binding ShowLocations}"/>

            <DockPanel Grid.Column="2">
                <Button Classes="flat" DockPanel.Dock="Bottom" Content="{Binding LoadMoreText}" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding ShowLoadMore}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                <ListBox x:Name="GraphList" Classes="graph" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedGraphRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         SelectionMode="Multiple" SelectionChanged="OnGraphSelectionChanged">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphRowViewModel">
                            <Border Background="Transparent" Padding="4,0">
                                <Border.ContextMenu>
                                    <ContextMenu Opening="OnMenuOpening">
                                        <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}" IsVisible="{Binding ShowCheckout}"/>
                                        <MenuItem Header="Cherry pick commit" Command="{Binding CherryPickCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Revert commit" Command="{Binding RevertCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Create" IsVisible="{Binding ShowRewrite}">
                                            <MenuItem Header="Create branch at commit" Command="{Binding CreateBranchAtCommand}"/>
                                            <MenuItem Header="Create tag at commit" Command="{Binding TagCommand}"/>
                                            <MenuItem Header="Patch" Command="{Binding PatchCommand}"/>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Create branch at HEAD" Command="{Binding CreateBranchCommand}" IsVisible="{Binding IsWorkingCopy}"/>
                                        <MenuItem Header="Copy SHA" Command="{Binding CopyShaCommand}" IsVisible="{Binding ShowLanes}"/>
                                        <MenuItem Header="Reset soft" Command="{Binding ResetSoftCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reset mixed" Command="{Binding ResetMixedCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reset hard" Command="{Binding ResetHardCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Rebase interactive…" Command="{Binding RebaseCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reword…" Command="{Binding RewordCommand}" IsVisible="{Binding ShowRewrite}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <controls:GraphRowPanel>
                                    <controls:LaneCanvas Geometry="{Binding Lanes}" IsVisible="{Binding DrawLanes}" VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                                    <StackPanel Margin="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Opacity="0.65" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}"
                                                  VerticalAlignment="Center" Margin="8,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="taglabel" Padding="6,0" CornerRadius="3" BorderThickness="1"
                                                        Background="#40E6B450" BorderBrush="#E6B450">
                                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </controls:GraphRowPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>

            <Grid x:Name="Details" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180" MinHeight="80"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border IsVisible="{Binding ShowingWorkingCopy}" Padding="8,6,8,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                                <TextBlock Text="Nothing staged." IsVisible="{Binding NothingStaged}" VerticalAlignment="Center" Opacity="0.7"/>
                                <SplitButton Content="Commit" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommitOrAmend}">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Commit without hooks" Command="{Binding CommitWithoutHooksCommand}" IsEnabled="{Binding CanCommit}"/>
                                            <MenuItem Header="Amend" Command="{Binding AmendCommand}" IsEnabled="{Binding CanAmend}"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </StackPanel>
                            <TextBox Text="{Binding CommitMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                     PlaceholderText="Commit message" KeyDown="OnCommitKeyDown"/>
                        </DockPanel>
                    </Border>
                    <StackPanel IsVisible="{Binding ShowingCommit}" Margin="8,6,8,4" Spacing="2">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="Hash" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                            <TextBox x:Name="CommitShaBox" Grid.Column="1" Classes="diff" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" Padding="0,1" MinHeight="0"
                                     Text="{Binding CommitShaText, Mode=OneWay}"/>
                            <TextBlock Grid.Row="1" Text="Author" VerticalAlignment="Center" Opacity="0.7" Margin="0,2,8,0"
                                       IsVisible="{Binding ShowCommitIdentity}"/>
                            <TextBox x:Name="CommitAuthorBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,2,0,0"
                                     BorderThickness="0" Background="Transparent" Padding="0,1" MinHeight="0"
                                     Text="{Binding CommitAuthorText, Mode=OneWay}" IsVisible="{Binding ShowCommitIdentity}"/>
                            <TextBlock Grid.Row="2" Text="Date" VerticalAlignment="Center" Opacity="0.7" Margin="0,2,8,0"
                                       IsVisible="{Binding ShowCommitIdentity}"/>
                            <TextBox x:Name="CommitDateBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,2,0,0"
                                     BorderThickness="0" Background="Transparent" Padding="0,1" MinHeight="0"
                                     Text="{Binding CommitDateText, Mode=OneWay}" IsVisible="{Binding ShowCommitIdentity}"/>
                        </Grid>
                        <StackPanel x:Name="CommitStatsRow" Orientation="Horizontal" Spacing="6" Margin="0,6,0,2"
                                    IsVisible="{Binding ShowCommitStats}">
                            <TextBlock x:Name="CommitStatsFiles" Text="{Binding CommitStatsFiles}" VerticalAlignment="Center"/>
                            <Border x:Name="CommitRemovedChip" Background="{DynamicResource CommitRemovedPillBrush}"
                                    CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock x:Name="CommitRemovedPill" Text="{Binding CommitStatsRemoved}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource CommitRemovedTextBrush}"/>
                            </Border>
                            <Border x:Name="CommitAddedChip" Background="{DynamicResource CommitAddedPillBrush}"
                                    CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock x:Name="CommitAddedPill" Text="{Binding CommitStatsAdded}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource CommitAddedTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="CommitMessageBox" IsReadOnly="True" Text="{Binding CommitMessageText, Mode=OneWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="168" MinHeight="28" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="8,0,6,4" ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding ShowingWorkingCopy}">
                    <Button Content="Stage all" Command="{Binding StageAllCommand}" IsEnabled="{Binding CanStageAll}"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Unstage all" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding CanUnstageAll}"/>
                    <Button Grid.Column="2" HorizontalAlignment="Right" Content="Discard all" Command="{Binding DiscardAllCommand}" IsEnabled="{Binding CanDiscardAll}"/>
                </Grid>

                <ListBox x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                         PointerReleased="OnFilePointerReleased">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRowViewModel">
                            <Panel>
                                <Border Classes="filehead" IsVisible="{Binding IsHeader}"
                                        Margin="4,8,4,2" Padding="8,4" CornerRadius="4" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="Transparent" Padding="6,2" IsVisible="{Binding IsFile}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opening="OnMenuOpening">
                                            <MenuItem Header="Stage" Command="{Binding StageCommand}" IsVisible="{Binding ShowStage}"/>
                                            <MenuItem Header="Unstage" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowUnstage}"/>
                                            <MenuItem Header="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}"/>
                                            <MenuItem Header="{Binding MergetoolMenu}" Command="{Binding MergetoolCommand}" IsVisible="{Binding ShowMergetool}"/>
                                            <MenuItem Header="File history" Command="{Binding HistoryCommand}" IsVisible="{Binding ShowHistory}"/>
                                            <Separator IsVisible="{Binding ShowLfsMenu}"/>
                                            <MenuItem Header="Track with LFS" Command="{Binding LfsTrackCommand}" IsVisible="{Binding ShowLfsTrack}"/>
                                            <MenuItem Header="Stop tracking with LFS" Command="{Binding LfsUntrackCommand}" IsVisible="{Binding ShowLfsUntrack}"/>
                                            <MenuItem Header="Download" Command="{Binding LfsDownloadCommand}" IsVisible="{Binding ShowLfsDownload}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="22,*,Auto,Auto">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}"/>
                                        <Border Grid.Column="2" IsVisible="{Binding LfsTracked}" Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                                                VerticalAlignment="Center" Background="#3347C4C4" ToolTip.Tip="Tracked with Git LFS">
                                            <TextBlock Text="LFS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                            <Button Classes="flat" Content="Stage" Command="{Binding StageCommand}" IsVisible="{Binding ShowStage}" Padding="6,0"/>
                                            <Button Classes="flat" Content="Unstage" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowUnstage}" Padding="6,0"/>
                                            <Button Classes="flat" Content="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}" Padding="6,0"/>
                                            <Button Classes="flat" Content="{Binding MergetoolLabel}" Command="{Binding MergetoolCommand}" IsVisible="{Binding ShowMergetool}" Padding="6,0"/>
                                            <Button Classes="flat" Content="History" Command="{Binding HistoryCommand}" IsVisible="{Binding ShowHistory}" Padding="6,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="3" ResizeDirection="Rows"/>

                <DockPanel Grid.Row="4">
                    <Border DockPanel.Dock="Top" Margin="8,4,8,0" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,-1">
                            <Button Classes="viewtab" Classes.selected="{Binding DiffTabOn}" Content="Diff" Command="{Binding ShowDiffCommand}"/>
                            <Button Classes="viewtab" Classes.selected="{Binding ShowingBlame}" Content="Blame" Command="{Binding ShowBlameCommand}"/>
                        </StackPanel>
                    </Border>
                    <CommandBar DockPanel.Dock="Top" Margin="0,4,0,0" IsVisible="{Binding ShowSectionFolds}"
                                DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                        <CommandBarButton Label="Expand all" Command="{Binding ExpandAllSectionsCommand}">
                            <CommandBarButton.Icon>
                                <PathIcon Width="14" Height="14" Data="M2,3 L8,9 L14,3 L12,3 L8,7 L4,3 Z M2,8 L8,14 L14,8 L12,8 L8,12 L4,8 Z"/>
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton Label="Collapse all" Command="{Binding CollapseAllSectionsCommand}">
                            <CommandBarButton.Icon>
                                <PathIcon Width="14" Height="14" Data="M2,7 L8,1 L14,7 L12,7 L8,3 L4,7 Z M2,13 L8,7 L14,13 L12,13 L8,9 L4,13 Z"/>
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                    </CommandBar>
                    <WrapPanel DockPanel.Dock="Top" Margin="8,4,8,0" IsVisible="{Binding ShowingMerge}">
                        <Button Classes="flat" Content="Previous" Command="{Binding PreviousConflictCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Next" Command="{Binding NextConflictCommand}" Margin="0,0,4,4"/>
                        <TextBlock Text="{Binding MergeConflictLabel}" VerticalAlignment="Center" Opacity="0.75" Margin="4,0,8,4"/>
                        <Button Classes="flat" Content="Take ours" Command="{Binding TakeOursCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Take theirs" Command="{Binding TakeTheirsCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="{Binding MergeBaseLabel}" Command="{Binding ToggleMergeBaseCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Save and stage" Command="{Binding SaveConflictCommand}" Margin="0,0,4,4"/>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,4">
                        <TextBlock Text="{Binding DiffNotice}" IsVisible="{Binding HasDiffNotice}" TextWrapping="Wrap"
                                   MaxLines="8" TextTrimming="CharacterEllipsis" Opacity="0.75"/>
                        <Button Classes="flat" Content="Load anyway" Command="{Binding LoadLargeDiffCommand}" IsVisible="{Binding ShowLoadDiff}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <ScrollViewer IsVisible="{Binding HasLfsNotice}" MaxHeight="168" Margin="0,4,0,0"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LfsNotice}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <Button Classes="flat" Content="Show the file" Command="{Binding ShowLfsCommand}" IsVisible="{Binding ShowLfsDownload}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid RowDefinitions="*,Auto">
                        <views:CopyListBox x:Name="DiffList" ItemsSource="{Binding DiffRows}" Background="Transparent" IsVisible="{Binding ShowingRows}"
                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <views:CopyListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </views:CopyListBox.Styles>
                            <views:CopyListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:DiffVirtualizingPanel/>
                                </ItemsPanelTemplate>
                            </views:CopyListBox.ItemsPanel>
                            <views:CopyListBox.DataTemplates>
                                <DataTemplate DataType="vm:DiffHunkRow" x:DataType="vm:DiffHunkRow">
                                    <Border Margin="8,10,8,4" Padding="8,6" CornerRadius="6" BorderThickness="1"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                        <DockPanel>
                                            <Button Classes="accent" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}" Margin="12,0,0,0"/>
                                            <views:CopyableText Classes="diff" CopyKey="span" Text="{Binding Header}" Opacity="0.85"
                                                                VerticalAlignment="Center" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffEditorRow" x:DataType="vm:DiffEditorRow">
                                    <views:DiffTextHost Editor="{Binding}" Shift="{Binding $parent[views:RepositoryView].SideShift}"/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffLineRow" x:DataType="vm:DiffLineRow">
                                    <DockPanel>
                                        <Button Classes="flat" DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}" Padding="6,0"/>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Classes="diff" Text="{Binding OldNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="0,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            <TextBlock Classes="diff" Text="{Binding NewNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="0,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <views:HighlightedText Classes="diff" CopyKey="body" Source="{Binding Text}" Language="{Binding Language}" Background="{Binding Background}" Padding="8,0"/>
                                    </DockPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffSideRow" x:DataType="vm:DiffSideRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,*">
                                        <TextBlock Classes="diff" Text="{Binding LeftNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="8,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{Binding LeftBackground}">
                                            <views:ClipShift Shift="{Binding $parent[views:RepositoryView].SideShift}">
                                                <views:HighlightedText Classes="diff" CopyKey="left" Source="{Binding Left}" Language="{Binding Language}" Padding="8,0" HorizontalAlignment="Left"/>
                                            </views:ClipShift>
                                        </Border>
                                        <Border Grid.Column="2" Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                                        <TextBlock Grid.Column="3" Classes="diff" Text="{Binding RightNumber}" MinWidth="48" TextAlignment="Right" Opacity="0.55" Margin="8,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        <Border Grid.Column="4" Background="{Binding RightBackground}">
                                            <views:ClipShift Shift="{Binding $parent[views:RepositoryView].SideShift}">
                                                <views:HighlightedText Classes="diff" CopyKey="right" Source="{Binding Right}" Language="{Binding Language}" Padding="8,0" HorizontalAlignment="Left"/>
                                            </views:ClipShift>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffImageRow" x:DataType="vm:DiffImageRow">
                                    <Grid Margin="8,0,8,12" ColumnDefinitions="*,12,*">
                                        <Border Padding="8" MinHeight="280" Background="#1A000000" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Image.BeforeCaption}" Opacity="0.72" Margin="0,0,0,8"/>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Image.BeforeDetail}" IsVisible="{Binding Image.HasBeforeDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding Image.BeforeNotice}" IsVisible="{Binding Image.ShowBeforeNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75"/>
                                                <controls:FbxOrbitView Source="{Binding Image.Before}" Orbit="{Binding Image.BeforeOrbit}" IsHitTestVisible="{Binding Image.HasBeforeOrbit}"
                                                                       MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Image.HasBefore}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="8" MinHeight="280" Background="#1A000000" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Image.AfterCaption}" Opacity="0.72" Margin="0,0,0,8"/>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Image.AfterDetail}" IsVisible="{Binding Image.HasAfterDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding Image.AfterNotice}" IsVisible="{Binding Image.ShowAfterNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75"/>
                                                <controls:FbxOrbitView Source="{Binding Image.After}" Orbit="{Binding Image.AfterOrbit}" IsHitTestVisible="{Binding Image.HasAfterOrbit}"
                                                                       MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Image.HasAfter}"/>
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Grid.ColumnSpan="3" IsVisible="{Binding Image.IsLoading}" IsHitTestVisible="False"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <controls:LoadingSpinner Width="22" Height="22" HorizontalAlignment="Center"
                                                                     IsVisible="{Binding Image.IsLoading}"
                                                                     AutomationProperties.Name="Loading image"/>
                                            <TextBlock Text="Loading…" HorizontalAlignment="Center" Opacity="0.72"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffFileRow" x:DataType="vm:DiffFileRow">
                                    <Border Margin="8,10,8,4" Padding="8,6" CornerRadius="6" BorderThickness="1"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            PointerPressed="OnDiffHeaderPressed">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="OnMenuOpening">
                                                <MenuItem Header="Copy filename" Command="{Binding FileMenu.CopyFileNameCommand}"/>
                                                <MenuItem Header="Copy path" Command="{Binding FileMenu.CopyPathCommand}"/>
                                                <MenuItem Header="Copy full path" Command="{Binding FileMenu.CopyFullPathCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="{Binding FileMenu.OpenFolderLabel}" Command="{Binding FileMenu.OpenFolderCommand}"/>
                                                <MenuItem Header="Open in editor" Command="{Binding FileMenu.OpenEditorCommand}"/>
                                                <Separator IsVisible="{Binding FileMenu.ShowLfsMenu}"/>
                                                <MenuItem Header="Track with LFS" Command="{Binding FileMenu.LfsTrackCommand}" IsVisible="{Binding FileMenu.ShowLfsTrack}"/>
                                                <MenuItem Header="Stop tracking with LFS" Command="{Binding FileMenu.LfsUntrackCommand}" IsVisible="{Binding FileMenu.ShowLfsUntrack}"/>
                                                <MenuItem Header="Download" Command="{Binding FileMenu.LfsDownloadCommand}" IsVisible="{Binding FileMenu.ShowLfsDownload}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Classes="flat" Width="16" Height="16" Padding="0" MinWidth="0"
                                                    Command="{Binding ToggleCommand}" IsVisible="{Binding CanFold}"
                                                    Background="Transparent" VerticalAlignment="Center"
                                                    ToolTip.Tip="Show or hide this file">
                                                <Path Data="M2,1 L7,6 L2,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                                                      RenderTransformOrigin="50%,50%">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="{Binding ExpandAngle}"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Tip}"/>
                                            <Border Grid.Column="2" IsVisible="{Binding LfsTracked}" Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                                                    VerticalAlignment="Center" Background="#3347C4C4" ToolTip.Tip="Tracked with Git LFS">
                                                <TextBlock Text="LFS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="vm:BlameRow" x:DataType="vm:BlameRow">
                                    <Grid ColumnDefinitions="48,180,*">
                                        <views:CopyableText Classes="diff" CopyKey="number" Text="{Binding Number}" Opacity="0.55"/>
                                        <views:CopyableText Grid.Column="1" Classes="diff" CopyKey="meta" Text="{Binding Meta}" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <views:HighlightedText Grid.Column="2" Classes="diff" CopyKey="blame" Source="{Binding Text}" Language="{Binding Language}"/>
                                    </Grid>
                                </DataTemplate>
                            </views:CopyListBox.DataTemplates>
                        </views:CopyListBox>
                        <views:MergeEditor Grid.Row="0" IsVisible="{Binding ShowingMerge}"
                                           Session="{Binding MergeEdit}"
                                           FilePath="{Binding MergePath}"
                                           ShowBase="{Binding ShowMergeBase}"
                                           ConflictIndex="{Binding MergeConflictIndex}"/>
                        <ScrollBar x:Name="SideBar" Grid.Row="1" Orientation="Horizontal"
                                   Minimum="0" AllowAutoHide="False" IsVisible="False"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="6" IsVisible="{Binding CommandsOpen}" HorizontalAlignment="Stretch"
                Height="168" Padding="8,4,8,8" Margin="0" ClipToBounds="True"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Commands" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="CommandLogBox" Grid.Row="1" Classes="diff"
                         IsReadOnly="True" AcceptsReturn="True" IsUndoEnabled="False"
                         TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         ClearSelectionOnLostFocus="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="No commands yet.">
                    <TextBox.ContextFlyout>
                        <MenuFlyout Opening="OnCommandLogMenuOpening">
                            <MenuItem Header="Copy" Command="{Binding $parent[TextBox].Copy}" IsEnabled="{Binding $parent[TextBox].CanCopy}" InputGesture="{x:Static TextBox.CopyGesture}"/>
                            <MenuItem x:Name="CommandLogSelectAllItem" Header="Select all" Command="{Binding $parent[TextBox].SelectAll}"/>
                        </MenuFlyout>
                    </TextBox.ContextFlyout>
                </TextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
