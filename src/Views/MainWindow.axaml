<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sextant.ViewModels"
        xmlns:views="using:Sextant.Views"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:app="using:Sextant"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Sextant.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/sextant.png"
        Title="{Binding TitleText}"
        Width="1200" Height="760"
        MinWidth="880" MinHeight="520"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

    <Window.Resources>
        <ControlTheme x:Key="RepositoryTabClose" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="{DynamicResource DockCloseButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource DockCloseButtonSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DockDocumentTabItemCornerRadius}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Padding="{TemplateBinding Padding}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource DockChromeButtonDangerHoverBrush}"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource DockChromeButtonPressedBackgroundBrush}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabStrip#RepositoryTabs">
            <Setter Property="Background" Value="{DynamicResource DockTabBackgroundBrush}"/>
            <Setter Property="MinHeight" Value="{DynamicResource DockHeaderHeight}"/>
        </Style>
        <Style Selector="TabStrip#RepositoryTabs TabStripItem" x:DataType="vm:RepositoryViewModel">
            <Setter Property="ToolTip.Tip" Value="{Binding ShortcutHint}"/>
            <Setter Property="Background" Value="{DynamicResource DockSurfacePanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockTabForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DockBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="{DynamicResource DockDocumentTabItemPadding}"/>
            <Setter Property="MinHeight" Value="{DynamicResource DockHeaderHeight}"/>
            <Setter Property="MinWidth" Value="{DynamicResource DockDocumentTabItemMinWidth}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DockDocumentTabItemCornerRadius}"/>
            <Setter Property="FontSize" Value="{DynamicResource DockFontSizeNormal}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabStrip#RepositoryTabs TabStripItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource DockTabHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockDocumentTabPointerOverForegroundBrush}"/>
        </Style>
        <Style Selector="TabStrip#RepositoryTabs TabStripItem:selected">
            <Setter Property="Background" Value="{DynamicResource DockSurfaceHeaderActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockTabActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DockBorderSubtleBrush}"/>
        </Style>
        <Style Selector="TabStrip#RepositoryTabs TabStripItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource DockSurfaceHeaderActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockTabActiveForegroundBrush}"/>
        </Style>
    </Window.Styles>

    <!-- The platform shows this menu. macOS uses the screen menu bar, so the bar below stays hidden there. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="_File">
                <NativeMenu>
                    <NativeMenuItem Header="_Open repository…" Command="{Binding OpenFolderCommand}" Gesture="{app:CommandGesture Key=O}"/>
                    <NativeMenuItem Header="Open from _WSL…" Command="{Binding OpenWslCommand}" IsVisible="{Binding HasWsl}"/>
                    <NativeMenuItem Header="_Clone repository…" Command="{Binding CloneCommand}"/>
                    <NativeMenuItem Header="_Init repository…" Command="{Binding InitCommand}"/>
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Apply _patch…" Command="{Binding ApplyPatchCommand}"/>
                    <NativeMenuItemSeparator IsVisible="{Binding ShowWindowExitMenu}"/>
                    <NativeMenuItem Header="E_xit" Command="{Binding ExitCommand}" IsVisible="{Binding ShowWindowExitMenu}"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_View" IsEnabled="{Binding HasActiveTab}">
                <NativeMenu>
                    <NativeMenuItem Header="_Window">
                        <NativeMenu>
                            <NativeMenuItem Header="_Locations" Command="{Binding ShowLocationsCommand}"/>
                            <NativeMenuItem Header="_History" Command="{Binding ShowHistoryCommand}"/>
                            <NativeMenuItem Header="_Commit" Command="{Binding ShowChangesCommand}"/>
                            <NativeMenuItem Header="Chan_ges" Command="{Binding ShowStagingCommand}"/>
                            <NativeMenuItem Header="_Diff" Command="{Binding ShowDiffCommand}"/>
                            <NativeMenuItem Header="_Blame" Command="{Binding ShowBlameCommand}"/>
                            <NativeMenuItem Header="_Repository files" Command="{Binding ShowFilesCommand}"/>
                            <NativeMenuItem Header="_LFS locks" Command="{Binding ShowLfsLocksCommand}"/>
                            <NativeMenuItem Header="Command _log" Command="{Binding ShowCommandsCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="_Reset layout" Command="{Binding ResetLayoutCommand}"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_Settings" IsVisible="{Binding ShowWindowSettingsMenu}">
                <NativeMenu>
                    <NativeMenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="_Repository" IsEnabled="{Binding HasActiveTab}">
                <NativeMenu>
                    <NativeMenuItem Header="_Create Branch" Command="{Binding CreateBranchCommand}" Gesture="{app:CommandGesture Key=B}"/>
                    <NativeMenuItem Header="_Pull" Command="{Binding PullCommand}" Gesture="{app:CommandGesture Key=U, Shift=True}"/>
                    <NativeMenuItem Header="_Push" Command="{Binding PushCommand}" IsEnabled="{Binding CanPush}" Gesture="{app:CommandGesture Key=P, Shift=True}"/>
                    <NativeMenuItem Header="Stage _all" Command="{Binding StageAllCommand}" IsEnabled="{Binding CanStageAll}" Gesture="{app:CommandGesture Key=A, Shift=True}"/>
                    <NativeMenuItem Header="_Unstage all" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding CanUnstageAll}" Gesture="{app:CommandGesture Key=R, Shift=True}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="_Stash">
                        <NativeMenu>
                            <NativeMenuItem Header="_Stash…" Command="{Binding StashCommand}" IsEnabled="{Binding CanStash}" Gesture="{app:CommandGesture Key=S}"/>
                            <NativeMenuItem Header="Stash (include _untracked)" Command="{Binding StashUntrackedCommand}" IsEnabled="{Binding CanStashUntracked}"/>
                            <NativeMenuItem Header="Stash (keep _index)" Command="{Binding StashKeepIndexCommand}" IsEnabled="{Binding CanStash}"/>
                            <NativeMenuItem Header="Stash (_staged)" Command="{Binding StashStagedCommand}" IsEnabled="{Binding CanStashStaged}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="_Pop latest stash…" Command="{Binding PopLatestStashCommand}" IsEnabled="{Binding CanPopLatestStash}" Gesture="{app:CommandGesture Key=S, Shift=True}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Add _remote…" Command="{Binding AddRemoteCommand}"/>
                    <NativeMenuItem Header="Add _worktree…" Command="{Binding AddWorktreeCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="_Fetch LFS objects" Command="{Binding FetchLfsCommand}"/>
                    <NativeMenuItem Header="_Pull LFS files" Command="{Binding PullLfsCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="_Search" Command="{Binding ToggleHistorySearchCommand}" Gesture="{app:CommandGesture Key=F}"/>
                </NativeMenu>
            </NativeMenuItem>
            <!-- macOS: Get help stays in the screen menu bar. About is in the Sextant application menu. -->
            <NativeMenuItem Header="_Help" IsVisible="{Binding ShowMacHelpMenu}">
                <NativeMenu>
                    <NativeMenuItem Header="_Get help" Command="{Binding GetHelpCommand}"/>
                </NativeMenu>
            </NativeMenuItem>
            <!-- Windows and Linux keep About Sextant under Help. -->
            <NativeMenuItem Header="_Help" IsVisible="{Binding ShowWindowAboutMenu}">
                <NativeMenu>
                    <NativeMenuItem Header="_Get help" Command="{Binding GetHelpCommand}"/>
                    <NativeMenuItem Header="_Check for update" Command="{Binding CheckForUpdateCommand}"/>
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="_About Sextant" Command="{Binding ShowAboutCommand}"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <NativeMenuBar Grid.Row="0"/>

        <Border Grid.Row="1" IsVisible="{Binding HasGitProblem}" Padding="12,8" Background="#33C42B1C">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Locate git" Command="{Binding LocateGitCommand}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding GitProblem}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*">
                <Border IsVisible="{Binding HasActiveTab}"
                        Background="{DynamicResource DockSurfacePanelBrush}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DockSeparatorBrush}">
                    <ScrollViewer x:Name="TabScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <TabStrip x:Name="RepositoryTabs" ItemsSource="{Binding Tabs}" SelectionChanged="OnRepositoryTabSelected">
                            <TabStrip.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </TabStrip.ItemsPanel>
                            <TabStrip.ItemTemplate>
                                <DataTemplate x:DataType="vm:RepositoryViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource DockToolChromeHeaderMargin}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="#D04040" IsVisible="{Binding IsConflicted}"/>
                                            <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="#E0A100" IsVisible="{Binding ShowDirtyDot}"/>
                                            <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="#3CB44B" IsVisible="{Binding ShowCleanDot}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="{DynamicResource DockToolChromeTitleMargin}"/>
                                        <Button Grid.Column="2" Theme="{StaticResource RepositoryTabClose}"
                                                Command="{Binding CloseTabCommand}"
                                                Margin="{DynamicResource DockChromeButtonMargin}">
                                            <Viewbox Width="8" Height="8">
                                                <Path Fill="{Binding $parent[TabStripItem].Foreground}"
                                                      Data="{DynamicResource DockToolIconCloseGeometry}"
                                                      Stretch="Uniform"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </TabStrip.ItemTemplate>
                        </TabStrip>
                    </ScrollViewer>
                </Border>
                <Panel Grid.Row="1" IsVisible="{Binding HasActiveTab}">
                    <ContentControl Content="{Binding ActiveTab}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:RepositoryViewModel">
                                <views:RepositoryChrome/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Panel>
                <Panel Grid.Row="2">
                    <dock:DockControl Layout="{Binding Dock.Root}" IsVisible="{Binding HasActiveTab}"/>
                    <Grid IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,24">
                            <Image Width="120" Height="120" Stretch="Uniform" HorizontalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="avares://Sextant/Assets/sextant.png"/>
                            <TextBlock Text="Sextant" FontSize="36" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Text="Open a repository to start." FontSize="16"
                                       HorizontalAlignment="Center" Opacity="0.8" Margin="0,36,0,0"/>
                            <Grid ColumnDefinitions="200,32,200,32,200" HorizontalAlignment="Center" Margin="0,32,0,0">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <Button Classes="accent" Content="Open" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="12,8" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding CanUseGit}"/>
                                    <TextBlock Text="Choose a folder that is already a Git repository."
                                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="10">
                                    <Button Content="Clone" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="12,8" Command="{Binding CloneCommand}" IsEnabled="{Binding CanUseGit}"/>
                                    <TextBlock Text="Copy a remote repository into a new folder and open it."
                                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="10">
                                    <Button Content="Init" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="12,8" Command="{Binding InitCommand}" IsEnabled="{Binding CanUseGit}"/>
                                    <TextBlock Text="Create a new Git repository in a folder you choose."
                                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="10" Margin="0,28,0,0" IsVisible="{Binding HasWsl}" HorizontalAlignment="Center" MaxWidth="420">
                                <Button Content="Open from WSL" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="12,8" Command="{Binding OpenWslCommand}" IsEnabled="{Binding CanOpenWsl}"/>
                                <TextBlock Text="Open a repository from a WSL2 distribution. That tab uses that distribution's git and configuration."
                                           TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Panel>
        </Grid>

        <Border Grid.Row="3" Padding="12,4" IsVisible="{Binding HasStatusText}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8"/>
        </Border>

        <Panel Grid.Row="2" IsVisible="{Binding PaletteOpen}" Background="#66000000" PointerPressed="OnPaletteBackdrop">
            <Border x:Name="CommandPalette" Width="520" MaxHeight="420" Margin="0,72,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Padding="8" CornerRadius="8"
                    Background="{DynamicResource FlyoutPresenterBackground}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    BoxShadow="0 2 8 0 #33000000, 0 12 28 0 #59000000"
                    PointerPressed="OnPaletteCardPressed">
                <DockPanel>
                    <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                             Text="{Binding PaletteQuery}" PlaceholderText="Command"
                             KeyDown="OnPaletteKeyDown"/>
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteMatches}" SelectedItem="{Binding SelectedPalette}"
                             Tapped="OnPaletteChosen">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,6"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteItem">
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Panel>
    </Grid>
</Window>
