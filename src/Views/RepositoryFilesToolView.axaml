<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:app="using:Sextant"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Sextant.Views.RepositoryFilesToolView"
             x:DataType="vm:RepositoryViewModel">
    <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6,8,2">
                        <ToggleButton Grid.Column="1" Content="Changes only"
                                      IsChecked="{Binding RepositoryFilesChangesOnly}"
                                      Padding="10,2" MinWidth="0" MinHeight="0"
                                      ToolTip.Tip="Show only staged, unstaged, and untracked files"
                                      AutomationProperties.Name="Show only changed files"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding RepositoryTreeEmptyText}" Margin="8"
                               IsVisible="{Binding RepositoryTreeEmpty}" Opacity="0.65"/>
                    <ListBox x:Name="RepositoryFileList" Grid.Row="1" ItemsSource="{Binding RepositoryFileTree}"
                             SelectedItem="{Binding SelectedRepositoryFile}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             DoubleTapped="OnRepositoryFileDoubleTapped" KeyDown="OnRepositoryFileKeyDown"
                             PointerReleased="OnRepositoryFilePointerReleased">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryFileTreeItem">
                                <Border Background="Transparent" Padding="4,3" ToolTip.Tip="{Binding Tip}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opening="OnMenuOpening">
                                            <MenuItem Header="Lock file" Command="{Binding LockCommand}" IsVisible="{Binding ShowLock}"/>
                                            <MenuItem Header="Unlock file" Command="{Binding UnlockCommand}" IsVisible="{Binding ShowUnlock}"/>
                                            <MenuItem Header="Force Unlock file" Command="{Binding ForceUnlockCommand}" IsVisible="{Binding ShowUnlock}"/>
                                            <Separator IsVisible="{Binding ShowLockActions}"/>
                                            <MenuItem Header="History" Command="{Binding HistoryCommand}"/>
                                            <Separator IsVisible="{Binding ShowOpen}"/>
                                            <MenuItem Header="{Binding FileMenu.OpenFolderLabel}" Command="{Binding FileMenu.OpenFolderCommand}"
                                                      IsVisible="{Binding ShowOpen}"/>
                                            <MenuItem Header="Open in editor" Command="{Binding FileMenu.OpenEditorCommand}"
                                                      IsVisible="{Binding ShowOpen}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove file…" Command="{Binding RemoveCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="16,18,Auto,*,Auto,Auto" Margin="{Binding Indent}">
                                        <Button Classes="flat" Width="16" Height="16" Padding="0" MinWidth="0"
                                                IsVisible="{Binding IsDirectory}" Background="Transparent"
                                                VerticalAlignment="Center" Click="OnRepositoryDirectoryExpand"
                                                DoubleTapped="OnLocationExpandDoubleTapped"
                                                AutomationProperties.Name="Expand or collapse directory">
                                            <Path Data="M2,1 L7,6 L2,11"
                                                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                                  StrokeLineCap="Round" StrokeJoin="Round" RenderTransformOrigin="50%,50%">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="{Binding ExpandAngle}"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                        <Path Grid.Column="1" Data="M1,3 L6,3 L8,5 L15,5 L15,13 L1,13 Z"
                                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1"
                                              IsVisible="{Binding IsDirectory}" VerticalAlignment="Center" Opacity="0.7"/>
                                        <Path Grid.Column="1" Data="M3,1 L10,1 L14,5 L14,15 L3,15 Z M10,1 L10,5 L14,5"
                                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1"
                                              IsVisible="{Binding IsFile}" VerticalAlignment="Center" Opacity="0.5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="SemiBold"
                                                   IsVisible="{Binding HasStatus}"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                   Margin="4,0" VerticalAlignment="Center"/>
                                        <Border Grid.Column="4" IsVisible="{Binding IsFile}" Padding="4,0" CornerRadius="3"
                                                Background="{DynamicResource SystemControlHighlightListLowBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StorageText}" FontSize="10" Opacity="0.75"/>
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding LockText}" FontSize="11"
                                                   IsVisible="{Binding HasLockInfo}"
                                                   Margin="6,0,2,0" VerticalAlignment="Center" Opacity="0.75"
                                                   MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
</UserControl>
