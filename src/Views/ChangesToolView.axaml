<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:app="using:Sextant"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Sextant.Views.ChangesToolView"
             x:DataType="vm:RepositoryViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Grid.Row="0">
                    <Border IsVisible="{Binding ShowingWorkingCopy}" Padding="8,6,8,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                                <TextBlock Text="Nothing staged." IsVisible="{Binding NothingStaged}" VerticalAlignment="Center" Opacity="0.7"/>
                                <SplitButton Classes="commit" Content="Commit" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommitOrAmend}">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Commit without hooks" Command="{Binding CommitWithoutHooksCommand}" IsEnabled="{Binding CanCommit}"/>
                                            <MenuItem Header="Amend" Command="{Binding AmendCommand}" IsEnabled="{Binding CanAmend}"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Classes="flat" Content="{Binding CommitterText}" Command="{Binding EditCommitterCommand}"
                                        Padding="4,2" MinHeight="0" FontSize="12" Opacity="0.85"
                                        ToolTip.Tip="Change the committer name and email"/>
                            </StackPanel>
                            <TextBox x:Name="CommitMessageInput" Text="{Binding CommitMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                     PlaceholderText="Commit message"/>
                        </DockPanel>
                    </Border>
                    <StackPanel IsVisible="{Binding ShowingCommit}" Margin="8,6,8,4" Spacing="2">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="Hash" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                            <TextBox x:Name="CommitShaBox" Grid.Column="1" Classes="diff" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" Padding="0,1" MinHeight="0"
                                     Text="{Binding CommitShaText, Mode=OneWay}"/>
                            <TextBlock Grid.Row="1" Text="Author" VerticalAlignment="Center" Opacity="0.7" Margin="0,2,8,0"
                                       IsVisible="{Binding ShowCommitIdentity}"/>
                            <TextBox x:Name="CommitAuthorBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,2,0,0"
                                     BorderThickness="0" Background="Transparent" Padding="0,1" MinHeight="0"
                                     Text="{Binding CommitAuthorText, Mode=OneWay}" IsVisible="{Binding ShowCommitIdentity}"/>
                            <TextBlock Grid.Row="2" Text="Date" VerticalAlignment="Center" Opacity="0.7" Margin="0,2,8,0"
                                       IsVisible="{Binding ShowCommitIdentity}"/>
                            <TextBox x:Name="CommitDateBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,2,0,0"
                                     BorderThickness="0" Background="Transparent" Padding="0,1" MinHeight="0"
                                     Text="{Binding CommitDateText, Mode=OneWay}" IsVisible="{Binding ShowCommitIdentity}"/>
                        </Grid>
                        <StackPanel x:Name="CommitStatsRow" Orientation="Horizontal" Spacing="6" Margin="0,6,0,2"
                                    IsVisible="{Binding ShowCommitStats}">
                            <TextBlock x:Name="CommitStatsFiles" Text="{Binding CommitStatsFiles}" VerticalAlignment="Center"/>
                            <Border x:Name="CommitRemovedChip" Background="{DynamicResource CommitRemovedPillBrush}"
                                    CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock x:Name="CommitRemovedPill" Text="{Binding CommitStatsRemoved}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource CommitRemovedTextBrush}"/>
                            </Border>
                            <Border x:Name="CommitAddedChip" Background="{DynamicResource CommitAddedPillBrush}"
                                    CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock x:Name="CommitAddedPill" Text="{Binding CommitStatsAdded}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource CommitAddedTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="CommitMessageBox" IsReadOnly="True" Text="{Binding CommitMessageText, Mode=OneWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="168" MinHeight="28" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Margin="8,0,6,4" ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding ShowingWorkingCopy}">
                    <Button Content="Stage all" Command="{Binding StageAllCommand}" IsEnabled="{Binding CanStageAll}"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Unstage all" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding CanUnstageAll}"/>
                    <Button Grid.Column="2" HorizontalAlignment="Right" Content="Discard all" Command="{Binding DiscardAllCommand}" IsEnabled="{Binding CanDiscardAll}"/>
                </Grid>

                <ListBox x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                         PointerReleased="OnFilePointerReleased">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRowViewModel">
                            <Panel>
                                <Border Classes="filehead" IsVisible="{Binding IsHeader}"
                                        Margin="4,8,4,2" Padding="8,4" CornerRadius="4" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="Transparent" Padding="6,2" IsVisible="{Binding IsFile}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opening="OnMenuOpening">
                                            <MenuItem Header="Stage" Command="{Binding StageCommand}" IsVisible="{Binding ShowStage}"/>
                                            <MenuItem Header="Unstage" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowUnstage}"/>
                                            <MenuItem Header="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}"/>
                                            <MenuItem Header="{Binding MergetoolMenu}" Command="{Binding MergetoolCommand}" IsVisible="{Binding ShowMergetool}"/>
                                            <MenuItem Header="File history" Command="{Binding HistoryCommand}" IsVisible="{Binding ShowHistory}"/>
                                            <Separator IsVisible="{Binding ShowLfsMenu}"/>
                                            <MenuItem Header="Track with LFS" Command="{Binding LfsTrackCommand}" IsVisible="{Binding ShowLfsTrack}"/>
                                            <MenuItem Header="Stop tracking with LFS" Command="{Binding LfsUntrackCommand}" IsVisible="{Binding ShowLfsUntrack}"/>
                                            <MenuItem Header="Download" Command="{Binding LfsDownloadCommand}" IsVisible="{Binding ShowLfsDownload}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="22,*,Auto,Auto">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}"/>
                                        <Border Grid.Column="2" IsVisible="{Binding LfsTracked}" Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                                                VerticalAlignment="Center" Background="#3347C4C4" ToolTip.Tip="Tracked with Git LFS">
                                            <TextBlock Text="LFS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                            <Button Classes="flat" Content="Stage" Command="{Binding StageCommand}" IsVisible="{Binding ShowStage}" Padding="6,0"/>
                                            <Button Classes="flat" Content="Unstage" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowUnstage}" Padding="6,0"/>
                                            <Button Classes="flat" Content="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}" Padding="6,0"/>
                                            <Button Classes="flat" Content="{Binding MergetoolLabel}" Command="{Binding MergetoolCommand}" IsVisible="{Binding ShowMergetool}" Padding="6,0"/>
                                            <Button Classes="flat" Content="History" Command="{Binding HistoryCommand}" IsVisible="{Binding ShowHistory}" Padding="6,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
    </Grid>
</UserControl>
