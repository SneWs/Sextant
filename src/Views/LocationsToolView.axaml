<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:app="using:Sextant"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Sextant.Views.LocationsToolView"
             x:DataType="vm:RepositoryViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*" Margin="8,2,4,2">
            <TextBox x:Name="LocationFilterBox" Grid.Row="0" Margin="4,0,4,4"
                     PlaceholderText="Filter" Text="{Binding LocationFilter}"
                     IsVisible="True" KeyDown="OnLocationFilterKeyDown" />
        </Grid>
        <ListBox x:Name="LocationList" Grid.Row="2" ItemsSource="{Binding Locations}"
                 SelectedItem="{Binding SelectedLocation}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Tapped="OnLocationTapped" DoubleTapped="OnLocationDoubleTapped">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocationItem">
                    <Border Background="Transparent" Padding="2,0">
                        <Border.ContextMenu>
                            <ContextMenu Opening="OnMenuOpening">
                                <MenuItem Header="Create branch from tag"
                                          Command="{Binding CreateBranchFromTagCommand}" IsVisible="{Binding ShowTag}" />
                                <MenuItem Header="Checkout tag" Command="{Binding CheckoutTagCommand}"
                                          IsVisible="{Binding ShowTag}" />
                                <MenuItem Header="Push tag" Command="{Binding PushTagCommand}"
                                          IsVisible="{Binding ShowTag}" />
                                <MenuItem Header="Delete tag" Command="{Binding DeleteCommand}"
                                          IsVisible="{Binding ShowTag}" />
                                <Separator IsVisible="{Binding ShowTag}" />
                                <MenuItem Header="Delete tag from origin" Command="{Binding DeleteRemoteTagCommand}"
                                          IsVisible="{Binding ShowTag}" />
                                <MenuItem Header="Open" Command="{Binding OpenCommand}" IsVisible="{Binding ShowOpen}" />
                                <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}"
                                          IsVisible="{Binding ShowCheckout}" />
                                <MenuItem Header="{Binding MergeLabel}" Command="{Binding MergeCommand}"
                                          IsVisible="{Binding ShowMerge}" />
                                <MenuItem Header="{Binding RebaseLabel}" Command="{Binding RebaseCommand}"
                                          IsVisible="{Binding ShowRebase}" />
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}"
                                          IsVisible="{Binding ShowDelete}" />
                                <MenuItem Header="Set upstream" Command="{Binding SetUpstreamCommand}"
                                          IsVisible="{Binding ShowSetUpstream}" />
                                <MenuItem Header="Show in graph" Command="{Binding RevealCommand}"
                                          IsVisible="{Binding ShowReveal}" />
                                <Separator IsVisible="{Binding ShowHide}" />
                                <MenuItem Header="{Binding HideLabel}" Command="{Binding HideCommand}"
                                          IsVisible="{Binding ShowHide}" />
                                <MenuItem Header="Hide all other branches" Command="{Binding HideOthersCommand}"
                                          IsVisible="{Binding ShowHideOthers}" />
                                <MenuItem Header="Show all branches" Command="{Binding ShowAllBranchesCommand}"
                                          IsVisible="{Binding ShowAllBranches}" />
                                <MenuItem Header="Rename" Command="{Binding RenameCommand}"
                                          IsVisible="{Binding ShowRename}" />
                                <MenuItem Header="Pop" Command="{Binding PopCommand}" IsVisible="{Binding ShowPop}" />
                                <MenuItem Header="Apply" Command="{Binding ApplyCommand}"
                                          IsVisible="{Binding ShowApply}" />
                                <MenuItem Header="Drop" Command="{Binding DropCommand}" IsVisible="{Binding ShowDrop}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="16,18,*,Auto" Margin="{Binding Indent}">
                            <Button Grid.Column="0" Classes="flat" Width="16" Height="16" Padding="0" MinWidth="0"
                                    IsVisible="{Binding HasChildren}"
                                    Click="OnLocationExpand" DoubleTapped="OnLocationExpandDoubleTapped"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Path Data="M2,1 L7,6 L2,11"
                                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                                      RenderTransformOrigin="50%,50%">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding ExpandAngle}" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                            <Path Grid.Column="1" Data="{Binding Icon}" IsVisible="{Binding ShowIcon}"
                                  AutomationProperties.Name="{Binding IconName}"
                                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  StrokeThickness="1.15"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  Stretch="None" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="2" Text="{Binding Label}" FontWeight="{Binding Weight}"
                                       Opacity="{Binding LabelOpacity}"
                                       Margin="4,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="flat eye" Width="18" Height="18" Padding="0" MinWidth="0"
                                    Margin="4,0,2,0"
                                    IsVisible="{Binding ShowEye}"
                                    Command="{Binding HideCommand}"
                                    ToolTip.Tip="{Binding HideLabel}"
                                    DoubleTapped="OnLocationExpandDoubleTapped"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M1,8 C4,3.5 12,3.5 15,8 C12,12.5 4,12.5 1,8 Z"
                                          Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          StrokeThickness="1.2"
                                          Fill="Transparent" />
                                    <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                             IsVisible="{Binding EyeOpen}" />
                                    <Line StartPoint="2.5,12.5" EndPoint="13.5,3.5"
                                          Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          StrokeThickness="1.3"
                                          StrokeLineCap="Round" IsVisible="{Binding EyeHidden}" />
                                </Canvas>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>