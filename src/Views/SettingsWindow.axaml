<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sextant.Views.SettingsWindow"
        Title="Settings"
        Width="840" Height="640"
        MinWidth="720" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <Grid ColumnDefinitions="180,*" RowDefinitions="*,Auto">
        <Border Grid.RowSpan="1" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <ListBox x:Name="Sections" SelectedIndex="0" SelectionChanged="OnSection">
                <ListBoxItem>Appearance</ListBoxItem>
                <ListBoxItem>Diff</ListBoxItem>
                <ListBoxItem>File types</ListBoxItem>
                <ListBoxItem>Git</ListBoxItem>
                <ListBoxItem>Merging</ListBoxItem>
            </ListBox>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="1" Padding="20,16">
            <Grid>
                <StackPanel x:Name="AppearancePage" Spacing="8">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Color theme" Opacity="0.75"/>
                    <ComboBox x:Name="PaletteBox" HorizontalAlignment="Left" MinWidth="240"/>
                    <RadioButton x:Name="FollowSystem" Content="Follow system" GroupName="SextantTheme"/>
                    <RadioButton x:Name="Light" Content="Light" GroupName="SextantTheme"/>
                    <RadioButton x:Name="Dark" Content="Dark" GroupName="SextantTheme"/>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Each theme has a light palette and a dark palette. Follow system uses the operating system's choice. A .xaml file in"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <InlineUIContainer BaselineAlignment="TextBottom">
                            <HyperlinkButton x:Name="ThemesFolderLink" Padding="0" MinHeight="0" MinWidth="0"
                                             Cursor="Hand" Click="OnOpenThemesFolder">
                                <TextBlock x:Name="ThemesFolderPath" TextDecorations="Underline" Cursor="Hand"/>
                            </HyperlinkButton>
                        </InlineUIContainer>
                        <Run Text="is listed here. It needs a Light palette and a Dark palette."
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="DiffPage" Spacing="8" IsVisible="False">
                    <TextBlock Text="Diff" FontSize="18" FontWeight="SemiBold"/>
                    <RadioButton x:Name="Inline" Content="Inline" GroupName="SextantDiff"/>
                    <RadioButton x:Name="SideBySide" Content="Side by side" GroupName="SextantDiff"/>
                    <CheckBox x:Name="IgnoreWhitespace" Content="Ignore whitespace"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Inline or side by side applies to every repository. Ignore whitespace passes -w for that diff only."/>
                </StackPanel>

                <StackPanel x:Name="FormatsPage" Spacing="8" IsVisible="False">
                    <TextBlock Text="File types" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="A matching extension is converted before the diff is shown. The transform command reads the file on stdin and writes the text to compare to stdout. $FILE is a temporary copy when the tool needs a path. The command is not a shell pipeline. Saving a merge runs the restore command, and its stdout is written back. Example: .json, transform jq ., restore jq -c ."/>
                    <Grid ColumnDefinitions="96,*,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Extension" Opacity="0.75"/>
                        <TextBlock Grid.Column="1" Text="Transform" Opacity="0.75"/>
                        <TextBlock Grid.Column="2" Text="Restore" Opacity="0.75"/>
                    </Grid>
                    <StackPanel x:Name="FormatRows" Spacing="8"/>
                    <Button Content="Add file type" HorizontalAlignment="Left" Click="OnAddFormat"/>
                </StackPanel>

                <StackPanel x:Name="GitPage" Spacing="8" IsVisible="False">
                    <TextBlock Text="Git" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Executable" Opacity="0.75"/>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="GitPath" PlaceholderText="Leave empty to use git on PATH"/>
                        <Button Grid.Column="1" Content="Browse…" Click="OnBrowseGit"/>
                        <Button Grid.Column="2" Content="Use system git" Click="OnUseSystemGit"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="An empty path uses the git executable on PATH."/>
                </StackPanel>

                <StackPanel x:Name="MergePage" Spacing="8" IsVisible="False">
                    <TextBlock Text="Merging" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="External merge command" Opacity="0.75"/>
                    <TextBox x:Name="MergeCommand" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="64"
                             PlaceholderText="Leave empty to resolve conflicts in Sextant"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Browse…" Click="OnBrowseMerge"/>
                        <Button Content="Use built-in editor" Click="OnClearMerge"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="An empty command resolves a text conflict in Sextant. If git already has merge.tool, that tool is used instead. A command here is passed to git mergetool for that run. $LOCAL is the current side, $REMOTE is the other side, $BASE is the common ancestor, and $MERGED is the file to save. Sextant does not write the command into git config."/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Example: meld &quot;$LOCAL&quot; &quot;$MERGED&quot; &quot;$REMOTE&quot;"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" Padding="16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancel"/>
                    <Button Content="OK" IsDefault="True" Click="OnOk"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
