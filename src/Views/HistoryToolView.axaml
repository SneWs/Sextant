<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:app="using:Sextant"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Sextant.Views.HistoryToolView"
             x:DataType="vm:RepositoryViewModel">
    <Grid>
            <DockPanel>
                <Button Classes="flat" DockPanel.Dock="Bottom" Content="{Binding LoadMoreText}" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding ShowLoadMore}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                <ListBox x:Name="GraphList" Classes="graph" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedGraphRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         SelectionMode="Multiple" SelectionChanged="OnGraphSelectionChanged">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                        <!-- The plate matches the history surface, then the same highlight the row uses, so subject text does not show through the chips. -->
                        <Style Selector="Border.chips">
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border.chipstate">
                            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pressed Border.chipstate">
                            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Border.chipstate">
                            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover Border.chipstate">
                            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected:pressed Border.chipstate">
                            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentHighBrush}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphRowViewModel">
                            <Border Background="Transparent" Padding="4,0">
                                <Border.ContextMenu>
                                    <ContextMenu Opening="OnMenuOpening">
                                        <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}" IsVisible="{Binding ShowCheckout}"/>
                                        <MenuItem Header="Cherry pick commit" Command="{Binding CherryPickCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Revert commit" Command="{Binding RevertCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Create" IsVisible="{Binding ShowRewrite}">
                                            <MenuItem Header="Create branch at commit" Command="{Binding CreateBranchAtCommand}"/>
                                            <MenuItem Header="Create tag at commit" Command="{Binding TagCommand}"/>
                                            <MenuItem Header="Patch" Command="{Binding PatchCommand}"/>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Create branch at HEAD" Command="{Binding CreateBranchCommand}" IsVisible="{Binding IsWorkingCopy}"/>
                                        <MenuItem Header="Copy SHA" Command="{Binding CopyShaCommand}" IsVisible="{Binding ShowLanes}"/>
                                        <MenuItem Header="Reset soft" Command="{Binding ResetSoftCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reset mixed" Command="{Binding ResetMixedCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reset hard" Command="{Binding ResetHardCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Rebase interactive…" Command="{Binding RebaseCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reword…" Command="{Binding RewordCommand}" IsVisible="{Binding ShowRewrite}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <controls:GraphRowPanel>
                                    <controls:LaneCanvas Geometry="{Binding Lanes}" IsVisible="{Binding DrawLanes}" VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                                    <StackPanel Margin="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Opacity="0.65" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Classes="chips" IsVisible="{Binding HasLabels}" VerticalAlignment="Stretch">
                                        <Border Classes="chipstate" Padding="8,0,4,0">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding Refs}" IsVisible="{Binding HasRefs}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Classes="reflabel" Padding="6,0" CornerRadius="3" BorderThickness="1">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.25"/>
                                                                </Border.Background>
                                                                <Border.BorderBrush>
                                                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}"/>
                                                                </Border.BorderBrush>
                                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Classes="taglabel" Padding="6,0" CornerRadius="3" BorderThickness="1"
                                                                    Background="#40E6B450" BorderBrush="#E6B450">
                                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border x:Name="RowFileCountChip" IsVisible="{Binding FileCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                        Padding="6,0" CornerRadius="3" MinWidth="22" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding FileCountTooltip}">
                                                    <TextBlock Text="{Binding FileCountText}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </controls:GraphRowPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border x:Name="HistoryLoadingOverlay" ZIndex="2"
                    IsVisible="{Binding IsLoadingHistory}" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="12,8" CornerRadius="8" Opacity="0.94"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    AutomationProperties.Name="Loading history">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LoadingSpinner Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Loading history…" VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
