<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sextant.App"
             xmlns:local="using:Sextant"
             xmlns:views="using:Sextant.Views"
             Name="Sextant"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the system until settings choose Light or Dark. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Text on the accent fill. Catppuccin puts Base on top of Blue. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CatppuccinOnAccentBrush" Color="#EFF1F5"/>
                    <SolidColorBrush x:Key="CommitAddedPillBrush" Color="#D8F5DC"/>
                    <SolidColorBrush x:Key="CommitAddedTextBrush" Color="#2B8A3E"/>
                    <SolidColorBrush x:Key="CommitRemovedPillBrush" Color="#FDE2E4"/>
                    <SolidColorBrush x:Key="CommitRemovedTextBrush" Color="#C92A2A"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CatppuccinOnAccentBrush" Color="#1E1E2E"/>
                    <SolidColorBrush x:Key="CommitAddedPillBrush" Color="#244032"/>
                    <SolidColorBrush x:Key="CommitAddedTextBrush" Color="#A6E3A1"/>
                    <SolidColorBrush x:Key="CommitRemovedPillBrush" Color="#4A2C35"/>
                    <SolidColorBrush x:Key="CommitRemovedTextBrush" Color="#F38BA8"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Replaces the default application menu. macOS shows this under the Sextant name and adds Hide and Quit. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Settings…" Click="OnOpenSettings" Gesture="Meta+,"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <!-- Catppuccin Latte. Base steps are the Text color at the Fluent alphas. -->
                <ColorPaletteResources x:Key="Light"
                                       Accent="#1E66F5"
                                       AltHigh="#FFFFFFFF" AltLow="#33FFFFFF" AltMedium="#99FFFFFF"
                                       AltMediumHigh="#CCFFFFFF" AltMediumLow="#66FFFFFF"
                                       BaseHigh="#FF4C4F69" BaseMediumHigh="#CC4C4F69" BaseMedium="#994C4F69"
                                       BaseMediumLow="#664C4F69" BaseLow="#334C4F69"
                                       ChromeAltLow="#FF4C4F69"
                                       ChromeBlackHigh="#FF000000" ChromeBlackLow="#33000000"
                                       ChromeBlackMediumLow="#66000000" ChromeBlackMedium="#CC000000"
                                       ChromeDisabledHigh="#FFCCD0DA" ChromeDisabledLow="#FF9CA0B0"
                                       ChromeGray="#FF8C8FA1" ChromeHigh="#FFACB0BE"
                                       ChromeLow="#FFEFF1F5" ChromeMedium="#FFE6E9EF" ChromeMediumLow="#FFEFF1F5"
                                       ChromeWhite="#FFFFFFFF"
                                       ListLow="#194C4F69" ListMedium="#334C4F69"
                                       ErrorText="#FFD20F39" RegionColor="#FFEFF1F5"/>
                <!-- Catppuccin Mocha. -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#89B4FA"
                                       AltHigh="#FF000000" AltLow="#33000000" AltMedium="#99000000"
                                       AltMediumHigh="#CC000000" AltMediumLow="#66000000"
                                       BaseHigh="#FFCDD6F4" BaseMediumHigh="#CCCDD6F4" BaseMedium="#99CDD6F4"
                                       BaseMediumLow="#66CDD6F4" BaseLow="#33CDD6F4"
                                       ChromeAltLow="#FFCDD6F4"
                                       ChromeBlackHigh="#FF000000" ChromeBlackLow="#33000000"
                                       ChromeBlackMediumLow="#66000000" ChromeBlackMedium="#CC000000"
                                       ChromeDisabledHigh="#FF313244" ChromeDisabledLow="#FF6C7086"
                                       ChromeGray="#FF7F849C" ChromeHigh="#FF585B70"
                                       ChromeLow="#FF11111B" ChromeMedium="#FF181825" ChromeMediumLow="#FF1E1E2E"
                                       ChromeWhite="#FFFFFFFF"
                                       ListLow="#19CDD6F4" ListMedium="#33CDD6F4"
                                       ErrorText="#FFF38BA8" RegionColor="#FF1E1E2E"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <Styles>
            <Styles.Resources>
                <ControlTheme x:Key="FlatButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ControlTemplate>
                    </Setter>
                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="RecognizesAccessKey" Value="True"/>
                    </Style>
                    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                    </Style>
                    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
                    </Style>
                    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"/>
                    </Style>
                </ControlTheme>
            </Styles.Resources>
            <Style Selector="Button.flat">
                <Setter Property="Theme" Value="{StaticResource FlatButton}"/>
            </Style>
            <Style Selector="Button.accent /template/ ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource CatppuccinOnAccentBrush}"/>
            </Style>
            <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource CatppuccinOnAccentBrush}"/>
            </Style>
            <Style Selector="Button.accent:pressed /template/ ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource CatppuccinOnAccentBrush}"/>
            </Style>
        </Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector=":is(TextBlock).diff">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector=":is(views|CopyableText)">
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColor}"/>
            <Setter Property="Cursor" Value="Ibeam"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <!-- CopyListBox uses the ListBox style key, so a CopyListBox type selector never matches. -->
        <Style Selector="ListBox.difflist ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.difflist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.diff">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>
</Application>
