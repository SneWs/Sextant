<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Product>Sextant</Product>
    <Authors>Marcus Grenängen</Authors>
    <Copyright>Copyright © 2026 Marcus Grenängen</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sextant.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Sextant.Git/**;Sextant.AskPass/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="ThirdParty\AssimpNetter-License.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="sextant.desktop" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\sextant.png" Link="sextant.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Sextant.Git\Sextant.Git.csproj" />
    <InternalsVisibleTo Include="Sextant.Git.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <!-- X11-on-XWayland does not see the compositor scale. Opt in; X11 stays the fallback. -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- Runtime XAML loader for user theme files. Compiled XAML does not need it. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Svg.Skia 5 pulls SkiaSharp 4. Pin the managed package and the Linux native together; Avalonia.Skia still brings the 3.119 Linux native. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <Import Project="MacApp.targets" />

  <!--
    SSH_ASKPASS must be a console executable. The helper is not in the solution, so a
    solution build does not compile it. Build the framework-dependent helper here, then
    copy it beside Sextant.exe. A Windows publish with a RID copies the self-contained
    helper into that folder so it uses the runtime already published with Sextant.
    macOS and Linux do not use this helper.
  -->
  <Target Name="BuildSextantAskPass" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Sextant.AskPass\Sextant.AskPass.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)Sextant.AskPass\Sextant.AskPass.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained" />
  </Target>

  <Target Name="CopySextantAskPass" AfterTargets="Build" DependsOnTargets="BuildSextantAskPass" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.exe" />
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.dll" />
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.deps.json" />
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_AskPassFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySextantAskPassPublish"
          AfterTargets="Publish"
          DependsOnTargets="BuildSextantAskPass"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.exe" />
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.dll" />
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.deps.json" />
      <_AskPassFile Include="$(MSBuildThisFileDirectory)Sextant.AskPass\bin\$(Configuration)\net10.0\Sextant.AskPass.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_AskPassFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishSextantAskPass"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and $(RuntimeIdentifier.StartsWith('win'))">
    <PropertyGroup>
      <!-- A separate dotnet process is required. The Build above restores this project
           without a RID, and an in-process Restore then reuses that assets file and
           fails with NETSDK1047. Deleting the assets file makes the new process restore
           for this RID. Do not redirect BaseIntermediateOutputPath: that stops excluding
           the project's own obj and compiles generated files twice. -->
      <_AskPassStage>$(MSBuildProjectDirectory)\obj\askpass-publish\$(RuntimeIdentifier)\</_AskPassStage>
      <_AskPassStageCmd>$(_AskPassStage.Replace('\', '/'))</_AskPassStageCmd>
      <_AskPassDest>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_AskPassDest>
    </PropertyGroup>
    <RemoveDir Directories="$(_AskPassStage)" />
    <MakeDir Directories="$(_AskPassStage)" />
    <Delete Files="$(MSBuildThisFileDirectory)Sextant.AskPass\obj\project.assets.json;$(MSBuildThisFileDirectory)Sextant.AskPass\obj\project.nuget.cache" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)Sextant.AskPass\Sextant.AskPass.csproj&quot; --configuration $(Configuration) --runtime $(RuntimeIdentifier) --self-contained true --output &quot;$(_AskPassStageCmd)&quot; -p:PublishSingleFile=false" />
    <Error Condition="!Exists('$(_AskPassStage)Sextant.AskPass.exe')" Text="Sextant.AskPass.exe was not published." />
    <ItemGroup>
      <_AskPassPublished Include="$(_AskPassStage)Sextant.AskPass.exe" />
      <_AskPassPublished Include="$(_AskPassStage)Sextant.AskPass.dll" />
      <_AskPassPublished Include="$(_AskPassStage)Sextant.AskPass.deps.json" />
      <_AskPassPublished Include="$(_AskPassStage)Sextant.AskPass.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_AskPassPublished)" DestinationFolder="$(_AskPassDest)" />
  </Target>
</Project>
